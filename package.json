{
  "name": "tarot-sticker-game",
  "version": "0.1.0",
  "private": true,
  "description": "Draw three tarot cards, get a playful reading about today's energy, and a sitcom sticker that matches it.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "validate": "node scripts/validate-data.js",
    "test": "node --test \"tests/*.test.js\"",
    "eval": "node scripts/eval-readings.js"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
