{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,config/**,public/**}"
    },
    "api/*.js": {
      "includeFiles": "{data/**,config/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/stocks",
      "destination": "/stocks.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?path=$1"
    }
  ]
}
