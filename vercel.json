{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,config/**,public/**,millioner/**}"
    },
    "api/*.js": {
      "includeFiles": "{data/**,config/**,public/**,millioner/**}"
    }
  },
  "redirects": [
    {
      "source": "/millioner",
      "destination": "/millioner/",
      "permanent": false
    },
    {
      "source": "/milyoner",
      "destination": "/millioner/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/stocks",
      "destination": "/stocks.html"
    },
    {
      "source": "/millioner/game",
      "destination": "/millioner/game.html"
    },
    {
      "source": "/millioner/leaderboard",
      "destination": "/millioner/leaderboard.html"
    },
    {
      "source": "/millioner/admin",
      "destination": "/millioner/admin.html"
    },
    {
      "source": "/milyoner/(.*)",
      "destination": "/millioner/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/millioner/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/millioner/js/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?path=$1"
    }
  ]
}
